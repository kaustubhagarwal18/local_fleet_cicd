# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
*.tfvars
!*.tfvars.example

# Rendered from the inventory by scripts/gen_prom_targets.sh
observability/prometheus/targets/

# Ansible
ansible/inventory/hosts.ini
ansible/inventory/group_vars/llama_fleet/vault.yml
*.retry

# Secrets / env
.env
.secrets
*.pem
*.key
# Fleet SSH keypair (scripts/ensure_ssh_key.sh generates this fresh per checkout)
terraform/modules/vm/ssh/

# Python
.venv/
__pycache__/
*.pyc

# Build artifacts
build/
*.gguf
llama.cpp/
artifacts/
*.log
/var/log/llama-fleet/

# OS
.DS_Store
