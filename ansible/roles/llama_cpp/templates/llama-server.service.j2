[Unit]
Description=llama.cpp inference server ({{ model_file }})
After=network.target

[Service]
Type=simple
User=ubuntu
Environment=LLAMA_LOG_JSON=1
Environment=LLAMA_LOG_DIR={{ log_dir }}
ExecStart={{ llama_release_dir }}/current/llama-server \
  -m {{ model_dir }}/{{ model_file }} \
  --host 0.0.0.0 --port {{ llama_server_port }} \
  --metrics
Restart=on-failure
RestartSec=2
StandardOutput=append:{{ log_dir }}/llama-server.jsonl
StandardError=append:{{ log_dir }}/llama-server.err.log

[Install]
WantedBy=multi-user.target
