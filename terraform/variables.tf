variable "vm_count" {
  description = "Number of fleet VMs to provision (2-3 per acceptance criteria)"
  type        = number
  default     = 3
  validation {
    condition     = var.vm_count >= 2 && var.vm_count <= 3
    error_message = "vm_count must be 2 or 3."
  }
}

variable "vm_name_prefix" {
  type    = string
  default = "llama-node"
}

variable "vm_cpus" {
  type    = number
  default = 2
}

variable "vm_memory" {
  type    = string
  default = "2G"
}

variable "vm_disk" {
  type    = string
  default = "10G"
}

variable "vm_image" {
  description = "Multipass base image"
  type        = string
  default     = "22.04"
}

variable "backend_engine" {
  description = "VM backend: multipass | lima | vagrant"
  type        = string
  default     = "multipass"
  validation {
    condition     = contains(["multipass", "lima", "vagrant"], var.backend_engine)
    error_message = "backend_engine must be one of: multipass, lima, vagrant."
  }
}

variable "ssh_public_key_path" {
  description = "Path to the fleet's SSH public key, injected into each VM via cloud-init. Generated by scripts/ensure_ssh_key.sh — never committed."
  type        = string
  default     = "modules/vm/ssh/fleet_ed25519.pub"
}

variable "ssh_private_key_path" {
  description = "Path to the fleet's SSH private key, used by Ansible to connect. Generated by scripts/ensure_ssh_key.sh — never committed."
  type        = string
  default     = "modules/vm/ssh/fleet_ed25519"
}
