# Copy to .env and fill in for local act runs / terraform.
# Never commit the real .env — see .gitignore.

TF_VAR_vm_count=3
TF_VAR_vm_cpus=2
TF_VAR_vm_memory=2G
TF_VAR_vm_disk=10G
TF_VAR_model_repo=Qwen/Qwen2.5-0.5B-Instruct-GGUF
TF_VAR_model_file=qwen2.5-0.5b-instruct-q4_k_m.gguf

# act secrets (put in a separate `.secrets` file, gitignored, referenced with `act --secret-file .secrets`)
# GITHUB_TOKEN=
